---
import dayjs from 'dayjs';
import path from 'node:path';
import Layout from '../layout/Layout.astro';
import GoBackButton from '../components/GoBackButton.astro';
import simpleGit, { type DefaultLogFields, type ListLogLine } from 'simple-git';

type GitLogCommit = DefaultLogFields & ListLogLine;

interface Props {
  lastCommit: GitLogCommit | null;
}

export async function getStaticPaths() {
  const git = simpleGit();
  let lastCommit: GitLogCommit | null = null;
  const file = path.join(process.cwd(), 'src', 'pages', 'now.astro');

  try {
    const log = await git.log({ file });
    lastCommit = log.latest;
  } catch (err) {
    console.error(err);
  }

  return {
    props: { lastCommit },
  };
}

const { lastCommit } = Astro.props;
---

<Layout>
  <GoBackButton />
  <section>
    <h1>Now</h1>
    <p>Last update: {dayjs(lastCommit?.date).format('YYYY-MM-DD HH:mm')}</p>
  </section>
  <article class='prose'>
    <section>
      <h2>What am I coding?</h2>
      <p>
        I'm currently working on building & fixing reliable and robust
        applications for the AI era as a freelance developer. I work mostly in
        the JavaScript/TypeScript ecosystem.
      </p>
      <p>I'm a Computer Science student at UFLA.</p>
      <p>
        I'm also working on some side projects:
        <ul>
          <li>Keeping this blog alive and trying to build a writing habit</li>
        </ul>
      </p>
    </section>
    <section>
      <h2>What are my current interests?</h2>
      <p>
        I'm currently interested in learning more about the following topics:
        <ul>
          <li>Software Architecture</li>
          <li>Distributed Systems</li>
        </ul>
      </p>
    </section>
    <section>
      <h2>What am I doing now?</h2>
      <p>
        Besides coding:
        <ul>
          <li>Running</li>
          <li>Trying to improve on calisthenics</li>
          <li>Reading literature & philosophy</li>
          <li>Hanging out with friends</li>
        </ul>
      </p>
    </section>
    <section>
      <h2>What am I reading now?</h2>
      <p>
        <ul>
          <li>The Metamorphosis, by Franz Kafka</li>
          <li>Software Architecture Fundamentals by Richards and Ford</li>
        </ul>
      </p>
    </section>
  </article>
</Layout>

<style>
  article section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
</style>
