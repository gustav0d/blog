---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import dayjs from 'dayjs';
import simpleGit, { type DefaultLogFields, type ListLogLine } from 'simple-git';
import path from 'path';

import Link from '../../../components/Link.astro';
import Layout from '../../../layout/Layout.astro';
import GoBackButton from '../../../components/GoBackButton.astro';
import Tag from '../../../components/Tag.astro';
import { GITHUB_REPO_URL, SITE } from '../../../config';

type GitLogCommit = DefaultLogFields & ListLogLine;
interface Props {
  post: CollectionEntry<'blog'>;
  lastCommit: GitLogCommit | null;
}

export async function getStaticPaths() {
  const git = simpleGit();
  const posts = await getCollection('blog');

  const postsMapped = posts.map(async (post) => {
    const file = post.filePath && path.join(process.cwd(), post.filePath);

    let lastCommit: GitLogCommit | null = null;
    try {
      if (file) {
        const log = await git.log({ file });
        lastCommit = log.latest;
      }
    } catch (err) {
      console.log(err);
    }

    return {
      params: {
        slug: post.data.slug,
      },
      props: {
        lastCommit,
        post: {
          ...post,
          data: {
            ...post.data,
            tags: post.data.tags || [],
          },
        },
      },
    };
  });

  return Promise.all(postsMapped);
}

const { post, lastCommit } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);

const date = dayjs(post.data.pubDate).format('YYYY-MM-DD HH:mm');

const tableOfContents = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((headings) => ({
    text: headings.text,
    url: `#${headings.slug}`,
    depth: headings.depth === 2 ? 1 : 2,
  }));

const readingTime = remarkPluginFrontmatter.readingTime;
---

<Layout
  ogImage={`/blog/${post.data.slug}/og.png`}
  head={{ title: `${post.data.title} | ${SITE.title}` }}
  customLang={post.data.tags?.includes('pt-br') ? 'pt-BR' : 'en'}
  showNavbar={false}>
  <GoBackButton />

  <section class='content'>
    <section class='header'>
      <section>
        <div class='meta'>
          {
            (post.data.tags || []).map((tag) => (
              <Link href={`/tag/${tag}`}>
                <Tag uppercase>{tag}</Tag>
              </Link>
            ))
          }
          <span class='meta-line'>
            <span>{date}</span>
            {
              readingTime && (
                <>
                  <span class='dot' aria-hidden>
                    ·
                  </span>
                  <span>{readingTime.text}</span>
                </>
              )
            }
            {
              lastCommit && (
                <>
                  <span class='dot' aria-hidden>
                    ·
                  </span>
                  <span>
                    <Link
                      href={`${GITHUB_REPO_URL}/commit/${lastCommit.hash.slice(0, 7)}`}
                      isExternal>
                      {lastCommit.hash.slice(0, 7)}
                    </Link>
                  </span>
                </>
              )
            }
          </span>
        </div>
        <h1>{post.data.title}</h1>
      </section>

      <article class='prose'>
        {
          tableOfContents.length > 0 ? (
            <details class='toc--wrapper' open>
              <summary>Table of Contents</summary>
              <section class='toc'>
                <ul>
                  {tableOfContents.map(({ text, url, depth }) => (
                    <li style={{ marginLeft: `${depth * 16}px` }}>
                      <div>
                        <Link href={url}>
                          <p>{text}</p>
                        </Link>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            </details>
          ) : null
        }
        <Content />
      </article>
    </section>
  </section>

  <style>
    .content {
      position: relative;
      display: flex;
      gap: var(--sp-8);
      flex-direction: column;
    }

    .header {
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      max-width: 34rem;
      padding-bottom: var(--sp-6);
      border-bottom: 0.5px solid var(--border);
    }

    .meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--sp-2);
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      font-size: 11px;
      color: var(--ink-500);
    }

    .meta .dot {
      color: var(--ink-300);
    }

    .toc--wrapper {
      background: var(--codeblock-bg);
      width: 100%;
      position: relative;
      padding: var(--sp-2);
      font-size: 13px;
    }

    @media screen and (min-width: 1024px) {
      .toc--wrapper {
        position: absolute;
        top: 5px;
        left: -300px;
        width: 270px;
      }
    }

    .toc {
      padding: var(--sp-4);
    }

    .toc--wrapper summary {
      cursor: pointer;
      color: var(--ink-700);
    }

    .toc ul {
      margin-left: 0;
    }

    .toc ul li p {
      text-align: left;
    }
  </style></Layout
>
