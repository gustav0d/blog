---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import dayjs from 'dayjs';
import simpleGit, { type DefaultLogFields, type ListLogLine } from 'simple-git';
import path from 'path';

import Link from '../../../components/Link.astro';
import Layout from '../../../layout/Layout.astro';
import GoBackButton from '../../../components/GoBackButton.astro';
import { GITHUB_REPO_URL, SITE } from '../../../config';

type GitLogCommit = DefaultLogFields & ListLogLine;
interface Props {
  post: CollectionEntry<'blog'>;
  lastCommit: GitLogCommit | null;
}

export async function getStaticPaths() {
  const git = simpleGit();
  const posts = await getCollection('blog');

  const postsMapped = posts.map(async (post) => {
    const file = post.filePath && path.join(process.cwd(), post.filePath);

    let lastCommit: GitLogCommit | null = null;
    try {
      if (file) {
        const log = await git.log({ file });
        lastCommit = log.latest;
      }
    } catch (err) {
      console.log(err);
    }

    return {
      params: {
        slug: post.data.slug,
      },
      props: {
        lastCommit,
        post: {
          ...post,
          data: {
            ...post.data,
            tags: post.data.tags || [],
          },
        },
      },
    };
  });

  return Promise.all(postsMapped);
}

const { post, lastCommit } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);

const date = dayjs(post.data.pubDate).format('YYYY-MM-DD');
const modifiedDate = lastCommit
  ? dayjs(lastCommit.date).format('YYYY-MM-DD')
  : null;
const commitShortHash = lastCommit ? lastCommit.hash.slice(0, 7) : null;
const commitUrl = lastCommit
  ? `${GITHUB_REPO_URL}/commit/${lastCommit.hash.slice(0, 7)}`
  : null;

const tableOfContents = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((headings) => ({
    text: headings.text,
    url: `#${headings.slug}`,
    depth: headings.depth === 2 ? 1 : 2,
  }));

const readingTime =
  remarkPluginFrontmatter.readingTime ??
  (() => {
    const words = post.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
    const minutes = Math.max(1, Math.round(words / 200));
    return { text: `${minutes} min read` };
  })();

const tags = post.data.tags || [];

// "Linked notes": posts actually connected via markdown links in the body
// (either this post links to them, or they link back to this post).
const allPosts = await getCollection('blog', ({ data }) => !data.hidden);

// ](<any non white-space>)
const MARKDOWN_LINK_RE = /\]\(([^)\s]+)\)/g;

const slugFromLink = (href: string) => {
  const path = href.startsWith(SITE.website)
    ? href.slice(SITE.website.length)
    : href;
  const match = path.match(/^\/blog\/([a-zA-Z0-9-]+)$/);
  return match?.[1] ?? null;
};

const extractLinkedSlugs = (body: string | undefined) => {
  const slugs = new Set<string>();
  for (const [, href] of body?.matchAll(MARKDOWN_LINK_RE) ?? []) {
    const slug = slugFromLink(href);
    if (slug) slugs.add(slug);
  }
  return slugs;
};

const outboundSlugs = extractLinkedSlugs(post.body);

const linkedNotes = allPosts
  .filter((other) => other.data.slug !== post.data.slug)
  .filter((other) => {
    const isOutbound = outboundSlugs.has(other.data.slug);
    const isBacklink = extractLinkedSlugs(other.body).has(post.data.slug);
    return isOutbound || isBacklink;
  })
  .sort((a, b) => (dayjs(b.data.pubDate).isAfter(a.data.pubDate) ? 1 : -1));
---

<Layout
  ogImage={`/blog/${post.data.slug}/og.png`}
  head={{ title: `${post.data.title} | ${SITE.title}` }}
  customLang={post.data.tags?.includes('pt-br') ? 'pt-BR' : 'en'}>
  <GoBackButton />

  <article class='note'>
    <div class='note-head'>
      <h1 class='title'>{post.data.title}</h1>

      <div class='path'>~/blog/{post.data.slug}</div>

      <div class='meta-line'>
        <span>created {date}</span>
        {
          modifiedDate && (
            <span class='dot' aria-hidden>
              ·
            </span>
          )
        }
        {
          modifiedDate && (
            <span>
              modified {modifiedDate}
              {commitUrl && commitShortHash && (
                <>
                  {' '}
                  (
                  <Link href={commitUrl} isExternal>
                    {commitShortHash}
                  </Link>
                  )
                </>
              )}
            </span>
          )
        }
        <span class='dot' aria-hidden>·</span>
        <span>{readingTime.text}</span>
      </div>

      {
        tags.length > 0 && (
          <div class='tags'>
            {tags.map((tag) => (
              <Link href={`/tag/${tag}`}>
                <span class='tag'>#{tag}</span>
              </Link>
            ))}
          </div>
        )
      }

      <div class='rule'></div>
    </div>

    {
      tableOfContents.length > 0 && (
        <details class='toc-wrapper' open>
          <summary>Table of Contents</summary>
          <p class='toc-label'>On this page</p>
          <section class='toc'>
            <ul>
              {tableOfContents.map(({ text, url, depth }) => (
                <li style={{ marginLeft: `${depth * 16}px` }}>
                  <Link href={url}>
                    <p>{text}</p>
                  </Link>
                </li>
              ))}
            </ul>
          </section>
        </details>
      )
    }

    <article class='prose'>
      <Content />
    </article>

    <div class='footer'>
      {
        linkedNotes.length > 0 && (
          <section class='linked'>
            <h2 class='section-title'>Linked notes</h2>
            <ul class='linked-list'>
              {linkedNotes.map((note) => (
                <li class='linked-item'>
                  <Link href={`/blog/${note.data.slug}`}>
                    #{note.data.slug}
                  </Link>
                  <span class='linked-date'>
                    {dayjs(note.data.pubDate).format('YYYY-MM-DD')}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </article>

  <style>
    .toc-wrapper {
      background: var(--codeblock-bg);
      width: 100%;
      max-width: var(--measure);
      padding: var(--sp-2);
      font-size: 13px;
      font-family: var(--font-mono);
    }

    .toc {
      padding: var(--sp-4);
    }

    .toc-wrapper summary {
      cursor: pointer;
      color: var(--ink-700);
    }

    .toc-label {
      display: none;
    }

    .toc ul {
      margin-left: 0;
    }

    .toc ul li p {
      text-align: left;
      white-space: normal;
      overflow-wrap: break-word;
    }

    .note {
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      max-width: var(--measure);
    }

    /* Groups the title block into one child, so the desktop grid below has a
       fixed row count. Carries .note's gap so the rhythm is unchanged. */
    .note-head {
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
    }

    .title {
      font-family: var(--font-serif);
      font-size: clamp(28px, 5vw, 40px);
      font-weight: 400;
      color: var(--ink-900);
    }

    .path {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--ink-300);
    }

    .meta-line {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--sp-2);
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--ink-500);
    }

    .dot {
      color: var(--ink-300);
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-3);
    }

    .tag {
      font-family: var(--font-mono);
      font-size: 11px;
      color: var(--ink-500);
    }

    .tag:hover {
      color: var(--ink-900);
    }

    .rule {
      border-top: 0.5px solid var(--border);
      margin: var(--sp-2) 0;
    }

    .footer {
      margin-top: var(--sp-6);
      padding-top: var(--sp-4);
      border-top: 0.5px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: var(--sp-6);
    }

    .section-title {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-500);
      font-weight: 400;
      margin-bottom: var(--sp-3);
    }

    .linked-list {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
    }

    .linked-item {
      display: flex;
      justify-content: space-between;
      gap: var(--sp-3);
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--ink-700);
    }

    .linked-date {
      font-size: 11px;
      color: var(--ink-500);
      white-space: nowrap;
    }

    @media (min-width: 1180px) {
      /*
        Shell escape: .wrap caps out at var(--shell) (48rem), which is
        narrower than the 13rem + var(--measure) + 13rem sidebar grid below.
        Widen it for this page only via a scoped :global() override.
      */
      :global(.wrap) {
        max-width: 68rem;
      }

      /* The three rows are .note-head, .prose and .footer. Declaring them
         explicitly is what lets the TOC's `grid-row: 1 / -1` below span the
         whole article: `-1` counts back from the last *explicit* row line, so
         without this it would collapse to row 1 and stretch it to the TOC's
         height. */
      .note {
        display: grid;
        grid-template-columns: 13rem minmax(0, var(--measure)) 13rem;
        grid-template-rows: repeat(3, auto);
        column-gap: var(--sp-8);
        row-gap: var(--sp-3);
        max-width: none;
        margin: 0 auto;
      }

      .note > :not(.toc-wrapper) {
        grid-column: 2;
      }

      .toc-wrapper {
        grid-column: 1;
        grid-row: 1 / -1;
        align-self: start;
        position: sticky;
        top: var(--sp-6);
        max-height: calc(100vh - 4rem);
        overflow-y: auto;
        overflow-wrap: break-word;
        white-space: normal;
        width: 13rem;
        max-width: none;
        background: none;
        padding: 0;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--ink-500);
      }

      .toc-wrapper summary {
        display: none;
      }

      .toc-label {
        display: block;
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-500);
        font-weight: 400;
        margin-bottom: var(--sp-3);
      }

      .toc {
        padding: 0;
      }

      .toc a:hover {
        color: var(--ink-900);
      }
    }
  </style>
</Layout>
