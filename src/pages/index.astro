---
import { getCollection } from 'astro:content';

import Layout from '../layout/Layout.astro';
import Link from '../components/Link.astro';
import { GITHUB_REPO_URL, TWITTER_URL, GITHUB_PROFILE_URL } from '../config';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const postsSorted = posts.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const year = new Date().getFullYear() - 2004;

const links = [
  [
    { href: '/now', title: '/now' },
    { href: '/til', title: '/til' },
    { href: '/lists', title: '/lists' },
    { href: '/tags', title: '/tags' },
  ],
];
---

<Layout>
  <section class='description'>
    <p>
      I'm a {year} year old software engineer from Brazil, with interests in software
      architecture, distributed systems, running, literature and philosophy. If you
      want to reach me, feel free to contact on <Link
        href={TWITTER_URL}
        isExternal>X/Twitter</Link
      > or via
      <Link href='mailto:gusdantas15@gmail.com'> email</Link>.
    </p>
    <p>
      If you want to see what I'm doing right now, you can check out my
      <Link href='/now'>/now</Link> page. On my
      <Link href={GITHUB_PROFILE_URL} isExternal>GitHub profile</Link>
      you can find all the repositories that I'm working on, and on my
      <Link href={GITHUB_REPO_URL} isExternal>blog repository</Link>
      you can find the source code of this blog.
    </p>
    <p>
      The blog is under <Link
        href={`${GITHUB_REPO_URL}/blob/main/LICENSE`}
        isExternal>GNU AGPLv3</Link
      >
      and <Link href={`${GITHUB_REPO_URL}/blob/main/LICENSE-posts`} isExternal
        >CC BY-SA 4.0</Link
      > licenses.
    </p>
  </section>
  <section class='links'>
    <h2>Links</h2>
    <div>
      {
        links.map((section) => (
          <ul>
            {section.map((link) => (
              <li>
                <Link href={link.href}>{link.title}</Link>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>
  <section class='posts'>
    <h2>Posts</h2>
    <div>
      {
        postsSorted.slice(0, 5).map((post) => (
          <a class='row' href={`/blog/${post.data.slug}`}>
            <p class='date'>{post.data.pubDate?.toISOString().split('T')[0]}</p>
            <p class='title'>{post.data.title}</p>
          </a>
        ))
      }
    </div>
    <Link href='/blog'>See all posts...</Link>
  </section>
</Layout>

<style>
  .description {
    display: flex;
    flex-direction: column;
    row-gap: var(--sp-4);
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .posts > div {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-6);
    padding: var(--sp-3) 0;
    border-bottom: 0.5px solid var(--border);
  }

  .date {
    font-size: 11px;
    color: var(--ink-500);
    white-space: nowrap;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--ink-900);
  }

  .row:hover .title {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 0.5px;
  }

  @media screen and (max-width: 425px) {
    .row {
      flex-direction: column;
      gap: var(--sp-1);
    }
  }

  .links ul li {
    margin-left: var(--sp-4);
    list-style-type: disc;
  }
</style>
