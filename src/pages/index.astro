---
import { getCollection } from 'astro:content';

import Layout from '../layout/Layout.astro';
import CvDownload from '../components/CvDownload.astro';
import Link from '../components/Link.astro';
import { TWITTER_URL } from '../config';

const HOME_POSTS_LIMIT = 5;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const postsSorted = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, HOME_POSTS_LIMIT);
const hasMorePosts = posts.length > HOME_POSTS_LIMIT;

const lists = await getCollection('lists');

const year = new Date().getFullYear() - 2004;

const links = [
  { href: '/now', title: '/now' },
  { href: '/blog', title: '/blog' },
  { href: '/til', title: '/til' },
  { href: '/lists', title: '/lists' },
  { href: '/tags', title: '/tags' },
];
---

<Layout>
  <h1>Dantas' blog</h1>
  <section class='intro'>
    <p>
      I'm a {year} year old software engineer from Brazil, with interests in software
      architecture, distributed systems, running, literature and philosophy. Reach
      me on {' '}
      <Link href={TWITTER_URL} isExternal>X/Twitter</Link> or via {' '}
      <Link href='mailto:gusdantas15@gmail.com'>email</Link>.
    </p>
    <CvDownload />
  </section>

  <section class='quick-links'>
    <ul>
      {
        links.map((link) => (
          <li>
            <Link href={link.href}>{link.title}</Link>
          </li>
        ))
      }
    </ul>
  </section>

  <section class='columns'>
    <div class='column'>
      <h2 class='column-heading'>Posts</h2>
      <div class='feed-list'>
        {
          postsSorted.map((post) => (
            <a class='feed-row' href={`/blog/${post.data.slug}`}>
              <span class='feed-date'>
                {post.data.pubDate.toISOString().split('T')[0]}
              </span>
              <span class='feed-title'>{post.data.title}</span>
            </a>
          ))
        }
      </div>
      {
        hasMorePosts && (
          <a class='see-all' href='/blog'>
            see all posts →
          </a>
        )
      }
    </div>

    <div class='column'>
      <h2 class='column-heading'>Lists</h2>
      <div class='feed-list'>
        {
          lists.map((list) => (
            <a class='feed-row feed-row--simple' href={`/lists/${list.id}`}>
              <span class='feed-title'>{list.data.title}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .intro {
    margin-bottom: var(--sp-4);
  }

  .quick-links ul {
    display: flex;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }

  .quick-links ul li {
    list-style-type: none;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6);
  }

  .column-heading {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-500);
    margin: 0 0 var(--sp-3);
  }

  .feed-list {
    display: flex;
    flex-direction: column;
  }

  .feed-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: baseline;
    gap: var(--sp-3);
    padding: var(--sp-2) 0;
    border-bottom: 0.5px solid var(--border);
  }

  .feed-row--simple {
    grid-template-columns: 1fr;
  }

  .feed-date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-500);
    white-space: nowrap;
  }

  .feed-title {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink-700);
  }

  .see-all {
    display: inline-block;
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-500);
  }

  .see-all:hover {
    color: var(--ink-900);
  }

  .feed-row:hover .feed-title {
    color: var(--ink-900);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 0.5px;
  }

  @media screen and (max-width: 640px) {
    .columns {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }

  @media screen and (max-width: 425px) {
    .feed-row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
