---
import Layout from '../layout/Layout.astro';
import GoBackButton from '../components/GoBackButton.astro';
import { getCollection, render } from 'astro:content';
import dayjs from 'dayjs';

const til = await getCollection('til');
const sortedTil = til.sort(
  (a, b) => b.data.createdAt.getTime() - a.data.createdAt.getTime(),
);

const items = await Promise.all(
  sortedTil.map(async (item) => {
    const createdAt = dayjs(item.data.createdAt).format(
      'YYYY/MM/DD ddd [-] hh:mm A',
    );
    const { Content } = await render(item);
    return { item, createdAt, Content };
  }),
);
---

<Layout>
  <GoBackButton />
  <div>
    <h1>Today I learned</h1>
    <p>Here show everything that I learned in some way during my day.</p>
  </div>
  <ul>
    {
      items.map(({ item, createdAt, Content }, i) => {
        return (
          <li>
            <p>{i + 1}.</p>
            <div class='content'>
              <a href={`#${item.data.slug}`}>
                <p class='title' id={item.data.slug}>
                  <span>{item.data.title}</span>
                  <span>{createdAt}</span>
                </p>
              </a>
              <section class='article'>
                <Content />
              </section>
            </div>
          </li>
        );
      })
    }
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  li {
    display: flex;
    gap: var(--sp-2);
  }

  li .content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    width: 100%;
  }

  .title {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    color: var(--ink-900);
  }

  li:not(:first-child) {
    border-top: 0.5px solid var(--border);
    padding-top: var(--sp-2);
  }

  section.article :global(li) {
    list-style-type: initial;
    margin-left: var(--sp-4);
  }

  section.article :global(pre) {
    overflow-x: auto;
    white-space: pre-wrap;
    word-wrap: break-word;
    text-align: left;
  }
</style>
