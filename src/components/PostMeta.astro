---
import Tag from './Tag.astro';

interface Props {
  tag?: string;
  items: string[];
}

const { tag, items } = Astro.props;
const parts = items.filter(Boolean);
---

<div class='meta'>
  {tag && <Tag uppercase>{tag}</Tag>}
  <span class='parts'>
    {
      parts.map((part, i) => (
        <>
          {i > 0 && (
            <span class='dot' aria-hidden>
              ·
            </span>
          )}
          <span>{part}</span>
        </>
      ))
    }
  </span>
</div>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: 11px;
    color: var(--ink-500);
  }

  .parts {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .dot {
    color: var(--ink-300);
  }
</style>
