---
import { GITHUB_REPO_URL } from '../config';
import Link from './Link.astro';

const navLinks = [
  { title: 'All my links', href: '/contact', isExternal: false },
  { title: 'Tags', href: '/tags', isExternal: false },
  { title: 'GitHub', href: GITHUB_REPO_URL, isExternal: true },
  { title: 'RSS', href: '/rss.xml', isExternal: false },
];
---

<footer>
  <p>
    {new Date().getUTCFullYear()}
  </p>
  <nav>
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <p>
              <Link href={link.href} isExternal={link.isExternal}>
                {link.title}
              </Link>
            </p>
          </li>
        ))
      }
    </ul>
  </nav>
</footer>

<style>
  footer {
    border-top: 0.5px solid var(--border);
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap-reverse;
    justify-content: space-between;
    margin-top: var(--sp-8);
    padding: var(--sp-4) 0 var(--sp-8);
  }

  footer p,
  footer :global(a) {
    font-size: 11px;
    color: var(--ink-500);
  }

  footer :global(a):hover {
    color: var(--ink-900);
  }

  @media screen and (max-width: 425px) {
    footer {
      flex-direction: column-reverse;
      align-items: center;
      gap: var(--sp-2);
    }

    footer * {
      flex: 1;
      text-align: center;
    }
  }

  footer nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }
</style>
