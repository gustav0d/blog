{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "format": "prettier --write .",
    "create:post": "pnpm n ./scripts/new-post.ts",
    "create:til": "pnpm n ./scripts/generate-til.ts",
    "n": "node --experimental-strip-types --disable-warning='ExperimentalWarning'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/spectral": "^5.2.8",
    "@react-pdf/renderer": "^4.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.0.6",
    "dayjs": "^1.11.21",
    "markdown-it": "^14.3.0",
    "sanitize-html": "^2.17.5",
    "satori": "^0.26.0",
    "simple-git": "^3.36.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@types/hast": "^3.0.4",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.17",
    "@types/sanitize-html": "^2.16.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "react": "19.2.7",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.4",
    "remark-math": "^6.0.0",
    "slugify": "^1.6.9",
    "unist-util-visit": "^5.1.0"
  }
